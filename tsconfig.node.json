{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "vite.config.ts",
    "vitest.integration.config.ts",
    "playwright.config.ts",
    "tests/e2e",
    "tests/integration",
    "tests/support",
    "server/**/*.test.ts",
    "vitest.live.config.ts",
    "tests/live",
    "vite.agent-dev.ts"
  ]
}
