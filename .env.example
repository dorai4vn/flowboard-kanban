# FlowBoard — biến môi trường cho frontend (Vite). Sao chép thành .env.local (đã bị git ignore).
# Chỉ dùng URL + publishable/anon key (công khai theo thiết kế, an toàn khi RLS bật).
# TUYỆT ĐỐI không đặt service_role / secret key / Google Client Secret ở đây.

# Supabase Local (npx supabase status): API_URL và PUBLISHABLE_KEY
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Chỉ dùng khi muốn thử Google login thật với Supabase Local (đặt trong shell, không commit):
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- M11: Trợ lý AI (chỉ phía server: Vercel Functions trong api/) ---
# KHÔNG đặt tiền tố VITE_ cho các biến dưới đây: chúng không bao giờ được đưa vào bundle trình duyệt.
# Server đọc SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY, nếu thiếu thì dùng lại hai biến VITE_ ở trên.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# Bắt buộc để Trợ lý AI chạy thật (nhập trên Vercel Dashboard → Settings → Environment Variables → Preview).
OPENAI_API_KEY=
# Tùy chọn: mặc định gpt-5.4-mini
OPENAI_MODEL=
# Tùy chọn nhưng nên đặt: chuỗi ngẫu nhiên dài ≥ 32 ký tự để ký trạng thái chờ duyệt xóa.
# Nếu bỏ trống, server tự suy ra từ OPENAI_API_KEY.
AGENT_STATE_SECRET=
